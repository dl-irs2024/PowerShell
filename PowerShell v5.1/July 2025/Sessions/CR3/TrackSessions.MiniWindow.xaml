<!--
===============================================================================
TrackSessions.MiniWindow.xaml
===============================================================================

PURPOSE:
  Small floating panel displayed when main window is minimized. Shows current
  machine and user info in a compact format. Can be restored back to main window.

USAGE CONTEXT:
  - Loaded at script startup by: New-MiniWindowObject()
  - Displayed when: BtnMinimize is clicked in main window
  - Hidden when: BtnRestoreMini is clicked to return to main window
  - Positioned in bottom-right corner of screen for unobtrusive monitoring

KEY SECTIONS:
  - Header: "Session Mini Panel" with animated icon
  - Machine Info: Current machine name (TxtMiniMachine)
  - User Info: Current user (TxtMiniUser)
  - Restore Button: Restore to main window view

EVENT HANDLERS WIRED:
  BtnRestoreMini.Click          -> Show main window, hide mini panel
  MiniWindow.MouseLeftButtonDown -> Allow drag-to-reposition window
  MiniRootBorder.MouseEnter     -> Highlight border on hover
  MiniRootBorder.MouseLeave     -> Reset border appearance

REFERENCED CONTROLS:
  ImgMiniIcon          - Small icon (usually animated spinner or status indicator)
  TxtMiniMachine       - Machine name display
  TxtMiniUser          - User name display
  ImgRestoreIcon       - Restore icon inside button
  BtnRestoreMini       - Button to restore main window
  MiniRootBorder       - Root container border

POWERSHELL FUNCTIONS USING THIS XAML:
  New-MiniWindowObject()         - Creates $miniWindow from this XAML
  Show-MiniPanel()               - Positions and displays mini window
  Update-MiniPanelInfo()         - Updates machine/user text
  Handle-MinimizeMainWindow()    - Triggered by BtnMinimize click

RESOURCE STYLES:
  Button style with FontWeight="Bold" applied

COLORS & THEMING:
  Background: #FFF8F0 (light cream/orange)
  Border color: #F0C9A2 (warm tan)
  Border background: #FFF3E8 (very light orange)
  Title text: #8A4F12 (dark brown)
  Info text: #5E442A (darker brown)

LAYOUT:
  Fixed size: Width=330, Height=150
  MinWidth=300, MinHeight=140
  WindowStyle: ToolWindow (no title bar decoration)
  ShowInTaskbar: False (doesn't appear in taskbar)
  Topmost: True (always on top of other windows)
  ResizeMode: NoResize (user cannot resize)
  WindowStartupLocation: Manual (positioned by code)

POSITIONING:
  Window position is calculated in code to place it in bottom-right corner
  Allows drag-repositioning via MouseLeftButtonDown handler

===============================================================================
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Session Mini"
		Width="330"
		Height="150"
		MinWidth="300"
		MinHeight="140"
		WindowStartupLocation="Manual"
		ResizeMode="NoResize"
		WindowStyle="ToolWindow"
		ShowInTaskbar="False"
		Topmost="True"
		Background="#FFF8F0">
	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>
	</Window.Resources>
	<Border Name="MiniRootBorder" Margin="8" CornerRadius="8" BorderThickness="1" BorderBrush="#F0C9A2" Background="#FFF3E8" Padding="10">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Image Name="ImgMiniIcon" Grid.Row="0" Grid.Column="0" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="Session Mini Panel" FontSize="14" FontWeight="SemiBold" Foreground="#8A4F12" VerticalAlignment="Center"/>

			<TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="TxtMiniMachine" Margin="0,8,0,2" FontSize="12" Foreground="#5E442A" TextWrapping="Wrap"/>
			<TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Name="TxtMiniUser" Margin="0,0,0,10" FontSize="12" Foreground="#5E442A" TextWrapping="Wrap"/>

			<Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Name="BtnRestoreMini" HorizontalAlignment="Right" Width="118" Height="30">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<Image Name="ImgRestoreIcon" Width="14" Height="14" Margin="0,0,6,0"/>
					<TextBlock Text="Restore" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
		</Grid>
	</Border>
</Window>
